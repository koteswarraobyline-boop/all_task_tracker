{
  "name": "task-tracker-backend",
  "version": "1.0.0",
  "description": "Backend API for Simple Multi-Project Development Task Tracker",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:prod": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test tests/*.test.js",
    "test:watch": "node --test --watch tests/*.test.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:reload": "pm2 reload ecosystem.config.cjs",
    "pm2:restart": "pm2 restart task-tracker-api",
    "pm2:stop": "pm2 stop task-tracker-api",
    "pm2:logs": "pm2 logs task-tracker-api",
    "pm2:status": "pm2 status",
    "deploy": "pm2 reload ecosystem.config.cjs --update-env || pm2 start ecosystem.config.cjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.9.7",
    "pdfkit": "^0.20.1",
    "sequelize": "^6.37.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "vitest": "^3.2.7"
  }
}

# Hosted / production — copy on the server:
#   cp .env.production.example .env
# Then set DB_* from cPanel → MySQL Databases (exact names).
# Document root → client/dist; .htaccess proxies /api to PORT below.
# Run with PM2: npm run pm2:start && pm2 save && pm2 startup

PORT=5004
HOST=0.0.0.0
NODE_ENV=production
TRUST_PROXY=1

DB_HOST=localhost
DB_PORT=3306
DB_USER=legatolx_dev_task_tracker
DB_PASS=your_mysql_password
DB_NAME=legatolx_dev_task_tracker

JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

CLIENT_APP_URL=https://tasktracker.legatolxp.online
CORS_ORIGINS=https://tasktracker.legatolxp.online

# Copy to .env on the production server and fill in real values.
# NEVER commit .env to git.

PORT=5004
HOST=0.0.0.0
NODE_ENV=production

DB_HOST=localhost
DB_PORT=3306
DB_USER=task_tracker
DB_PASS=CHANGE_ME_STRONG_DB_PASSWORD
DB_NAME=task_tracker

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_STRING

ADMIN_USERNAME=admin
# Used only when seeding the first admin account
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# Public HTTPS URL of the app (used in client share links)
CLIENT_APP_URL=https://your-domain.com

# Comma-separated allowed browser origins (usually same as CLIENT_APP_URL)
CORS_ORIGINS=https://your-domain.com

# Optional
# CLIENT_DIST_PATH=../client/dist
# DB_SYNC_ALTER=false
# TRUST_PROXY=1
# JSON_BODY_LIMIT=2mb
# CSV_UPLOAD_MAX_MB=10

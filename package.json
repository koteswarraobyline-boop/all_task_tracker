{
  "name": "task-tracker",
  "private": true,
  "version": "1.0.0",
  "description": "Task Tracker — monorepo helpers for local + PM2 hosting",
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "pm2:start": "npm --prefix server run pm2:start",
    "pm2:reload": "npm --prefix server run pm2:reload",
    "pm2:restart": "npm --prefix server run pm2:restart",
    "pm2:logs": "npm --prefix server run pm2:logs",
    "pm2:status": "npm --prefix server run pm2:status",
    "deploy": "npm --prefix server run deploy"
  }
}
